{
    "name": "ondjila/commerce-api",
    "description": "Ondjila Commerce Backend API — PHP Puro",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "firebase/php-jwt": "^7.0",
        "phpmailer/phpmailer": "^6.9",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "helpers/ResponseHelper.php",
            "helpers/JwtHelper.php"
        ]
    },
    "config": {
        "optimize-autoloader": true
    }
}
